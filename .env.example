# Ruby's.pk — environment variables
# Copy this file to .env.local and adjust the values for your machine.

# Site URL (used for canonical URLs, sitemap, robots and structured data)
NEXT_PUBLIC_SITE_URL=https://teal-quetzal-684361.hostingersite.com
NEXT_PUBLIC_SITE_NAME="Ruby's"

# SQLite database file. Relative paths are resolved from the project root.
# The file is created automatically on first run, or with `npm run db:init`.
# On Hostinger, point this at a persistent directory outside the deploy folder.
DATABASE_PATH=./data/rubys.db

# ------------------------------------------------------------------
# Admin dashboard
# ------------------------------------------------------------------
# Admin accounts are created from the command line only. There is no
# default password and no admin is seeded automatically:
#
#   npm run db:migrate
#   npm run admin:create
#
# The command prompts for the email, name, phone and a strong password.
# For non-interactive servers you can pass these environment variables:
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD="a-long-strong-password"
# ADMIN_FIRST_NAME=Ruby
# ADMIN_LAST_NAME=Admin
# ADMIN_PHONE=03001234567
# ADMIN_ROLE=admin
#
# Admin passwords are hashed with scrypt. Never commit real credentials.

# Optional: Google Search Console verification token
NEXT_PUBLIC_GSC_VERIFICATION=""

# Optional: Google Analytics measurement ID (only loaded if you add the script)
NEXT_PUBLIC_GA_ID=""

# Optional: email/SMTP settings for future transactional email integration
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@rubys.pk"

# Optional: payment gateway credentials for future live integrations
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
